# ─────────────────────────────────────────────────────────────────────────────
# ETHIO MUSIC API — environment template. Copy to .env and fill in.
# NEVER commit .env files. The service-role key NEVER leaves this process.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>                     # public key, RLS protects data
SUPABASE_SERVICE_ROLE_KEY=<service-role key>     # server-side ONLY
SUPABASE_JWT_SECRET=<project JWT secret>         # local HS256 verification

# Direct Postgres (pooler, session mode) — analytics, jobs, transactions
SUPABASE_REF=<project-ref>
SUPABASE_DB_PASSWORD=<postgres role password>
SUPABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com

# Telegram
TELEGRAM_BOT_TOKEN=<bot token from @BotFather>   # alias: TG_BOT_TOKEN
TG_WEBHOOK_SECRET=<random string>                # X-Telegram-Bot-Api-Secret-Token
TG_INITDATA_MAX_AGE=86400                        # seconds initData stays valid

# HTTP
CORS_ORIGINS=https://tech-insight21.github.io    # comma-separated allowlist
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15
SEARCH_RATE_LIMIT_MAX=120

# Cache / jobs
CACHE_TTL_MS=60000
WORKER_ENABLED=true                              # notification queue worker
WORKER_BATCH_SIZE=25
NOTIFY_CRON=*/1 * * * *                          # queue poll schedule
RELEASES_CRON=*/5 * * * *                        # new-release fan-out
PREMIUM_CRON=17 7 * * *                          # premium expiry notices
MAINTENANCE_CRON=3 4 * * *                       # history trim, expiry sweep

# Optional: forward non-payment bot message updates to the command bot
# COMMAND_FORWARD_URL=https://bot-host/telegram-update
