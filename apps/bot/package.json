{
  "name": "ethio-music-bot",
  "version": "2.0.0",
  "private": true,
  "description": "ETHIO MUSIC Telegram bot (Telegraf) — search, artist follows, new-release notifications, mini app launcher",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "notify": "NOTIFY_ONLY=1 tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-store.ts",
    "smoke:notify": "tsx scripts/smoke-notify.ts",
    "e2e": "tsx scripts/e2e-local.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "pg": "^8.13.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
