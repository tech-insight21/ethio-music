# ─────────────────────────────────────────────────────────────────────────────
# ETHIO MUSIC — environment template. Copy to .env and fill in.
# NEVER commit .env files. Never expose the service-role key to clients.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mini app (apps/tma) — these two are PUBLIC by design (RLS protects data) ─
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... or anon key>

# ── Bot (apps/bot) — server-side only ────────────────────────────────────────
BOT_TOKEN=<from @BotFather>                  # or TELEGRAM_BOT_TOKEN
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key — public, RLS-protected>
TMA_URL=https://tech-insight21.github.io/ethio-music/

# Postgres connection for the bot_* tables (chat registry, follows, dedup).
# Either DATABASE_URL or the three-part form below:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_REF=<project-ref>
SUPABASE_DB_PASSWORD=<postgres role password>
SUPABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com

# Comma-separated Telegram user ids allowed to use /admin /broadcast /notify
# (find yours with @userinfobot). Empty = admin commands refuse to run.
ADMIN_TELEGRAM_IDS=

# Run modes
# (default)         long polling — local dev
# WEBHOOK_URL=...   https public base URL → webhook mode (prod hosting)
# PORT=3000         webhook listen port
# WEBHOOK_PATH=/telegram-webhook
# WEBHOOK_SECRET=<random string>   X-Telegram-Bot-Api-Secret-Token check
# NOTIFY_ONLY=1     headless one-shot new-release dispatch (CI cron), then exit

# ── Server-only (REST API / admin jobs). NEVER prefix with NEXT_PUBLIC_ ─────
# SUPABASE_SERVICE_ROLE_KEY=<service role key — bypasses RLS, keep server-side>
